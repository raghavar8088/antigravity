# =============================================================================
# PRODUCTION ENVIRONMENT REFERENCE
# =============================================================================
# DO NOT put real values in this file. This is documentation only.
# Production secrets are stored in AWS Secrets Manager:
#   Secret name: antigravity/production/engine
#
# How to populate Secrets Manager:
#   aws secretsmanager put-secret-value \
#     --secret-id antigravity/production/engine \
#     --secret-string file://secrets.json
#
# Vercel env vars: set in Vercel dashboard → Project → Settings → Environment
# Engine env vars: injected by ECS task definition from Secrets Manager
# =============================================================================

# ─── ENGINE (ECS) ─────────────────────────────────────────────────────────────
# These are injected via Secrets Manager (see ecs.tf secrets[])
# NEVER put in .env file on disk or in environment variables in plaintext

MONGODB_URI=                     # MongoDB Atlas connection string (srv+ssl)
DATABASE_URL=                    # Aurora PostgreSQL: postgres://user:pass@host/db?sslmode=require
REDIS_URL=                       # ElastiCache TLS: rediss://:auth@primary:6379/0

BINANCE_API_KEY=                 # Binance REST API key
BINANCE_API_SECRET=              # Binance REST API secret

DELTA_API_KEY=                   # Delta Exchange API key
DELTA_API_SECRET=                # Delta Exchange API secret

ENGINE_ADMIN_SECRET=             # Min 32 random bytes — required in production

OPENAI_API_KEY=                  # OpenAI for AI strategy loop
GEMINI_API_KEY=                  # Gemini fallback
GROQ_API_KEY=                    # Groq fallback (free tier)

# ─── ENGINE RUNTIME (non-secret, in ECS task definition environment[]) ────────
PORT=8080
ENGINE_EXECUTION_AUTHORITY=1
SECURITY_ENFORCE_AUTH=true
MAX_POSITION_BTC=2
MAX_DAILY_LOSS_PCT=0.03
SQLITE_PATH=                     # Empty in ECS — SQLite disabled in production
MONGODB_DB=loop_trades

# ─── VERCEL (set in Vercel dashboard, not in this file) ───────────────────────
AUTH_JWT_SECRET=                 # 64+ random bytes for JWT signing — server side only
CRON_SECRET=                     # 64 hex chars — mandatory, set or cron endpoints lock
INTERNAL_API_URL=                # https://<ALB domain or engine URL>
ENGINE_URL=                      # Same as INTERNAL_API_URL
ENGINE_ADMIN_SECRET=             # Same value as engine ENGINE_ADMIN_SECRET (never NEXT_PUBLIC_)
MONGODB_URI=                     # Same Atlas URI (for Next.js API routes)
MONGODB_DB=loop_trades

# ─── VERCEL PUBLIC FLAGS (safe to expose to browser) ─────────────────────────
NEXT_PUBLIC_ENGINE_EXECUTION_AUTHORITY=1
NEXT_PUBLIC_BTC_FT_WINNERS_ONLY=1

# ─── AWS Terraform Secrets Manager setup ─────────────────────────────────────
# After terraform apply, run:
#   aws secretsmanager put-secret-value \
#     --secret-id $(terraform output -raw secrets_manager_arn) \
#     --secret-string '{
#       "MONGODB_URI": "mongodb+srv://...",
#       "DATABASE_URL": "postgres://antigravity_admin:PASS@AURORA_ENDPOINT/antigravity?sslmode=require",
#       "REDIS_URL": "rediss://:AUTH_TOKEN@REDIS_PRIMARY:6379/0",
#       "BINANCE_API_KEY": "...",
#       ...
#     }'
#
# The ECS task definition pulls individual keys at launch:
#   { "name": "MONGODB_URI", "valueFrom": "SECRET_ARN:MONGODB_URI::" }
