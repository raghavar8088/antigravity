{
  "description": "Infrastructure: Go runtime, CPU, memory, PostgreSQL, TimescaleDB, Redis, Vault, DR readiness",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": {"steps":[{"color":"green","value":null}]} }},
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Goroutines",
      "type": "stat",
      "targets": [{ "expr": "go_goroutines", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" },
        "thresholds": {"steps":[{"color":"green","value":null},{"color":"yellow","value":500000000},{"color":"red","value":1000000000}]} }},
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Heap In Use",
      "type": "stat",
      "targets": [{ "expr": "go_memstats_heap_inuse_bytes", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": {"steps":[{"color":"green","value":null},{"color":"yellow","value":10},{"color":"red","value":50}]} }},
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "GC Pause P99 (ms)",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.99, rate(go_gc_duration_seconds_bucket[5m])) * 1000", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [
        {"options":{"0":{"color":"red","index":0,"text":"DOWN"},"1":{"color":"green","index":1,"text":"UP"}},"type":"value"}
      ], "color": {"mode":"thresholds"}, "thresholds": {"steps":[{"color":"red","value":null},{"color":"green","value":1}]} }},
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "PostgreSQL",
      "type": "stat",
      "targets": [{ "expr": "trading_db_available{db='postgres'}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [
        {"options":{"0":{"color":"red","index":0,"text":"DOWN"},"1":{"color":"green","index":1,"text":"UP"}},"type":"value"}
      ], "color": {"mode":"thresholds"}, "thresholds": {"steps":[{"color":"red","value":null},{"color":"green","value":1}]} }},
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Redis",
      "type": "stat",
      "targets": [{ "expr": "trading_redis_available", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [
        {"options":{"0":{"color":"red","index":0,"text":"DOWN"},"1":{"color":"green","index":1,"text":"UP"}},"type":"value"}
      ], "color": {"mode":"thresholds"}, "thresholds": {"steps":[{"color":"red","value":null},{"color":"green","value":1}]} }},
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Vault",
      "type": "stat",
      "targets": [{ "expr": "trading_vault_available", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "title": "Go Memory: Heap, Stack, GC",
      "type": "timeseries",
      "targets": [
        { "expr": "go_memstats_heap_alloc_bytes", "refId": "A", "legendFormat": "Heap Alloc" },
        { "expr": "go_memstats_heap_inuse_bytes", "refId": "B", "legendFormat": "Heap In Use" },
        { "expr": "go_memstats_stack_inuse_bytes", "refId": "C", "legendFormat": "Stack In Use" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "title": "DB Query Latency P95 by Operation",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(trading_db_query_latency_ms_bucket[5m]))", "refId": "A", "legendFormat": "{{ db }} {{ operation }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 9,
      "title": "DB Connection Pool",
      "type": "timeseries",
      "targets": [
        { "expr": "trading_db_pool_connections", "refId": "A", "legendFormat": "{{ db }} {{ state }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" },
        "thresholds": {"steps":[{"color":"green","value":null},{"color":"yellow","value":300},{"color":"red","value":600}]} }},
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 10,
      "title": "DR Snapshot Age (seconds)",
      "type": "timeseries",
      "targets": [
        { "expr": "trading_dr_snapshot_age_seconds", "refId": "A", "legendFormat": "{{ aggregate_type }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": {"steps":[{"color":"red","value":null},{"color":"yellow","value":0.5},{"color":"green","value":1}]} }},
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
      "id": 11,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minValue": 0, "maxValue": 1 },
      "title": "DR Readiness Score",
      "type": "gauge",
      "targets": [{ "expr": "trading_dr_readiness_score", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 20 },
      "id": 12,
      "title": "Worker Heartbeats",
      "type": "timeseries",
      "targets": [
        { "expr": "time() - trading_worker_last_heartbeat_unix", "refId": "A", "legendFormat": "{{ worker }} (seconds since last heartbeat)" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 20 },
      "id": 13,
      "title": "Active HTTP Connections",
      "type": "timeseries",
      "targets": [
        { "expr": "trading_api_active_connections", "refId": "A", "legendFormat": "Active Connections" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["trading", "infrastructure"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "UTC",
  "title": "06 — Infrastructure Dashboard",
  "uid": "trading-infrastructure",
  "version": 1
}
