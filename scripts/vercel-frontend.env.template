# =============================================================================
# VERCEL FRONTEND — Next.js client runtime environment (template)
# =============================================================================
# These are the environment variables the Next.js app (client/) reads at build
# + runtime. Set them in the Vercel dashboard (Project antigravity ->
# Settings -> Environment Variables) or via the CLI:
#
#   source scripts/vercel-deploy.env      # loads VERCEL_TOKEN
#   vercel env add MONGODB_URI production --token "$VERCEL_TOKEN"
#
# For local dev, copy this into client/.env.local (gitignored) and fill it in.
#
# Values left as __SET_ME__ are secrets you must supply. NEXT_PUBLIC_* vars are
# exposed to the browser — never put secrets in those. Non-secret defaults are
# already filled in.
# =============================================================================

# -----------------------------------------------------------------------------
# Engine connection (Next.js -> Go engine on AWS)
# -----------------------------------------------------------------------------
# Point at the AWS Lightsail engine (port 80 -> container 8080). No trailing slash.
INTERNAL_API_URL=http://13.233.8.80
ENGINE_URL=http://13.233.8.80
# Browser-exposed API base (optional; only if the client calls the engine directly).
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Databases (server-side API routes)
# -----------------------------------------------------------------------------
MONGODB_URI=__SET_ME__
MONGODB_DB=loop_trades
MONGODB_DB_NAME=loop_trades
# PostgreSQL (Neon) — trade history / spot state. Optional.
DATABASE_URL=__SET_ME__

# -----------------------------------------------------------------------------
# Auth / security — MUST match the engine's values
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=__SET_ME__
ENGINE_ADMIN_SECRET=__SET_ME__
# Owner login credentials (admin password is a bcrypt/argon hash, not plaintext).
ADMIN_USERNAME=__SET_ME__
ADMIN_PASSWORD_HASH=__SET_ME__
# 64-char hex secret protecting /api/cron/* routes (Vercel cron auth).
CRON_SECRET=__SET_ME__
# Account-key wiring (OWNER_ACCOUNT_KEY is authoritative; DESK_WORKER is legacy).
OWNER_ACCOUNT_KEY=__SET_ME__
DESK_WORKER_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# Brokers (Delta Exchange — server-side signing)
# -----------------------------------------------------------------------------
DELTA_API_KEY=__SET_ME__
DELTA_API_SECRET=__SET_ME__
DELTA_API_BASE_URL=https://api.india.delta.exchange
DELTA_TESTNET=false
DELTA_PROXY_URL=
DELTA_BTC_FUTURES_SYMBOL=BTCUSD

# -----------------------------------------------------------------------------
# Supabase storage (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=__SET_ME__

# -----------------------------------------------------------------------------
# Observability / UI
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GRAFANA_URL=
NEXT_PUBLIC_TERMINAL_WS_URL=
# Material 3 UI toggle (1 = on by default, 0 = off).
NEXT_PUBLIC_UI_M3=1

# -----------------------------------------------------------------------------
# Trading flags — server-side
# -----------------------------------------------------------------------------
LIVE_TRADING_ENABLED=false
KILL_SWITCH_ENABLED=true
DESK_SELF_HEAL_AUTO=0
MOCK_TRADE_UNCAPPED=0
RANDOM_TRADER_MAX_OPEN=
