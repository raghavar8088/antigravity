# =============================================================================
# AWS SSH BACKEND — Go engine runtime environment (template)
# =============================================================================
# Runtime config for the engine on the AWS Lightsail server (13.233.8.80,
# ap-south-1 / Mumbai). docker-compose.prod.yml loads it via `env_file: .env`
# from the repo root ON the server.
#
# To activate on the box (after `git pull`):
#     cp scripts/aws-engine.env.template .env
#     nano .env                          # fill in every __SET_ME__ secret
#     bash scripts/update-aws-engine.sh  # rebuild + restart the container
#
# NEVER commit the real `.env` (it is gitignored). Only this template is tracked.
# Values left as __SET_ME__ are secrets you must supply. Everything else has a
# safe production default already filled in.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime / process
# -----------------------------------------------------------------------------
PORT=8080
APP_VERSION=prod
LOG_LEVEL=info
GOMEMLIMIT=450MiB
GOGC=70

# SQLite engine state (local fallback persistence). Path is inside the container.
SQLITE_ENABLED=true
SQLITE_PATH=/app/data/engine.db
# Filesystem snapshot dir used when MongoDB is unavailable.
ENGINE_DATA_DIR=/app/data/snapshots

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
# MongoDB Atlas — paper trades, auth sessions, audit logs.
MONGODB_URI=__SET_ME__
MONGODB_DB=loop_trades
# PostgreSQL (Neon / TimescaleDB) — metrics + phase 14 schema. Optional.
DATABASE_URL=__SET_ME__
# Redis — indicator + performance cache. Optional.
REDIS_URL=__SET_ME__

# -----------------------------------------------------------------------------
# Brokers / market data
# -----------------------------------------------------------------------------
# Coinbase public WS — primary BTC-USD price feed (no auth).
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# Delta Exchange (India) — BTC options ticks + orders.
DELTA_API_KEY=__SET_ME__
DELTA_API_SECRET=__SET_ME__
DELTA_API_BASE_URL=https://api.india.delta.exchange
DELTA_TESTNET=false
DELTA_PROXY_URL=
DELTA_BTC_FUTURES_SYMBOL=BTCUSD
DELTA_OPTIONS_BTC_TICKER=

# Binance REST — BTC spot fallback.
BINANCE_API_KEY=__SET_ME__
BINANCE_API_SECRET=__SET_ME__

# AngelOne — NSE/BSE equity + NIFTY.
ANGELONE_API_KEY=__SET_ME__
ANGELONE_CLIENT_CODE=__SET_ME__
ANGELONE_PIN=__SET_ME__
ANGELONE_TOTP_SECRET=__SET_ME__

# -----------------------------------------------------------------------------
# AI / strategy brain providers (all optional — fill the ones you use)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=__SET_ME__
GEMINI_API_KEY=__SET_ME__
GROQ_API_KEY=__SET_ME__
ANTHROPIC_API_KEY=__SET_ME__
OPENROUTER_API_KEY=__SET_ME__
HUGGINGFACE_API_KEY=__SET_ME__
MISTRAL_API_KEY=__SET_ME__
CLOUDFLARE_API_KEY=__SET_ME__
CLOUDFLARE_ACCOUNT_ID=__SET_ME__
# Optional external ML scorer endpoint.
ML_SCORER_ENDPOINT=

# -----------------------------------------------------------------------------
# Security / auth (engine)
# -----------------------------------------------------------------------------
# Shared JWT secret — MUST match the client's AUTH_JWT_SECRET on Vercel.
AUTH_JWT_SECRET=__SET_ME__
# Admin secret guarding /admin + risk/kill endpoints. MUST match client.
ENGINE_ADMIN_SECRET=__SET_ME__
# Secret for Next.js -> engine internal calls (optional).
INTERNAL_API_SECRET=__SET_ME__
# Comma-separated service name:secret pairs (optional).
SERVICE_SECRETS=
# Auth enforcement (keep true in prod).
SECURITY_ENFORCE_AUTH=true
SECURITY_ENFORCE_ADMIN_IP=false
# Comma-separated CORS allow-list (e.g. https://antigravity.vercel.app).
ALLOWED_ORIGINS=
# Comma-separated CIDRs allowed to hit admin endpoints (used if ADMIN_IP on).
ENGINE_ADMIN_CIDR=
# Use local secrets instead of AWS Secrets Manager / Vault.
USE_LOCAL_SECRETS=true
AWS_REGION=ap-south-1
# HashiCorp Vault (optional — only if USE_LOCAL_SECRETS=false).
VAULT_ADDR=
VAULT_TOKEN=

# -----------------------------------------------------------------------------
# Paper trading / execution
# -----------------------------------------------------------------------------
PAPER_TRADING_AUTO_EXECUTE=true
PAPER_OMS_ADMIN_OVERRIDE=
INITIAL_PAPER_BALANCE_USD=1000000
INITIAL_OPTIONS_BALANCE_USD=1000000
RESET_PAPER_BALANCE_ON_BOOT=false
MIN_EXECUTION_SIZE_BTC=0.001
MAX_POSITION_BTC=1.0
MAX_DAILY_LOSS_PCT=5
# Account-key wiring (OWNER_ACCOUNT_KEY is authoritative; DESK_WORKER is legacy).
OWNER_ACCOUNT_KEY=__SET_ME__
DESK_WORKER_ACCOUNT_KEY=
# Strategy rollout phase + live-trading / kill-switch gates.
STRATEGY_ROLLOUT_PHASE=
LIVE_TRADING_ENABLED=false
KILL_SWITCH_ENABLED=true

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SERVICE_NAME=antigravity-engine
METRICS_PATH=/metrics
OTEL_ENABLED=false
OTEL_JAEGER_ENDPOINT=
OTEL_SAMPLING_RATE=0.1

# -----------------------------------------------------------------------------
# Python integration (optional — only if running the brain locally)
# -----------------------------------------------------------------------------
PYTHON_PATH=
ETF_SCRIPT_PATH=
MACRO_SCRIPT_PATH=
SENTIMENT_SERVER_URL=
TEMPORAL_PATTERNS_PATH=
