{
  "title": "Trading Database Infrastructure",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["trading", "postgres", "timescaledb", "mongodb", "pgbouncer"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Query Latency p95 (ms)",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(pg_query_latency_seconds_bucket[5m])) by (le, query_class)) * 1000" }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "PgBouncer Pool Usage",
      "targets": [
        { "expr": "pgbouncer_pools_cl_active" },
        { "expr": "pgbouncer_pools_cl_waiting" },
        { "expr": "pgbouncer_pools_sv_active" }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "stat",
      "title": "PostgreSQL Cache Hit Rate",
      "targets": [
        { "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])))" }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Replication Lag (seconds)",
      "targets": [
        { "expr": "pg_replication_lag_seconds" }
      ],
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Timescale Inserts Per Second",
      "targets": [
        { "expr": "sum(rate(trading_market_ticks_inserted_total[1m])) by (symbol)" }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Data Quality Score",
      "targets": [
        { "expr": "trading_data_quality_score" }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Backup Freshness",
      "targets": [
        { "expr": "time() - trading_db_last_successful_backup_timestamp" }
      ],
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }
    }
  ]
}
