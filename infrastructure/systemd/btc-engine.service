[Unit]
Description=BTC Trading Engine — Antigravity
Documentation=https://github.com/your-org/btc-pilot
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/btc-pilot/engine

# Verify DB connections before starting the engine
ExecStartPre=/home/ubuntu/btc-pilot/scripts/health-check-pre-start.sh

ExecStart=/home/ubuntu/btc-pilot/engine/bin/antigravity

Restart=always
RestartSec=5

# Do NOT auto-restart when the kill switch fires (exit code 2)
# or when the binary exits cleanly (exit code 0 = intentional shutdown)
RestartPreventExitStatus=0 2

EnvironmentFile=/home/ubuntu/btc-pilot/engine/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=btc-engine

# Allow enough file descriptors for concurrent WebSocket connections
LimitNOFILE=65536

# Give the engine time to flush open positions before SIGKILL
TimeoutStopSec=30

# Send SIGTERM first, then SIGKILL after TimeoutStopSec
KillMode=mixed

[Install]
WantedBy=multi-user.target
