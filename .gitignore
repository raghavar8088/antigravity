# Go cache
.gocache/
engine/.gocache*/
engine/.gotmp*/
bin/
*.exe
*.test
*.prof

# Node cache
node_modules/
.next/
dist/
build/
.env
.env.local

# Broker credentials (Live Engine) — never commit
.application.properties/

# Raw historical market data (large, regenerable)
engine/data/historical/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Engine Temp
engine/cmd/antigravity/main.go.*
engine/internal/**/*.go.*
# Logs
*.log
dev-server.err
dev-server2.err

# Runtime data and generated trading artifacts
runtime/

# Graphify knowledge graph outputs (rebuild with: npm run graphify:rebuild)
graphify-out/
graphify-scopes/
engine/internal/graphify-out/
engine/cmd/graphify-out/

# Claude bot secrets (local + Lightsail copies)
claude-bot/auth.json
claude-bot/.env
claude-bot/log.txt
claude-bot/last-reply.txt
claude-bot/.send.lock
claude-bot/screenshots/
.vercel

# Local credential material — never commit
.application-credentials/

# AWS SSH deploy config (contains host + key path)
scripts/aws-deploy.env

# Vercel deploy config (contains API token)
scripts/vercel-deploy.env

# Filled runtime env files (real secrets). Only the *.template copies are tracked.
.env
scripts/aws-engine.env
scripts/vercel-frontend.env

# External integration/research repos (shallow clones, not part of this repo)
integrations/**/
!integrations/README.md

# SSH private keys — never commit
*.pem
