{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install --legacy-peer-deps --ignore-scripts",
  "crons": [
    {
      "path": "/api/cron/mock-trading-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/policy-snapshot",
      "schedule": "5 0 * * *"
    }
  ]
}
