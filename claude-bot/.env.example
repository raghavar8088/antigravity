# Copy to .env on Lightsail: cp .env.example .env

# fixed = post into one existing chat thread (recommended)
# new   = open a fresh chat each run and optionally save the reply
MODE=fixed

# Required when MODE=fixed — copy URL from your browser address bar
CLAUDE_CHAT_URL=https://claude.ai/chat/YOUR_CHAT_ID

# Optional override; if empty, a message is picked from messages.json by day-of-year
MESSAGE=

# Path to rotating messages (default: ./messages.json)
MESSAGES_FILE=./messages.json

# Wait up to N ms for assistant reply when MODE=new (default: 90000)
REPLY_TIMEOUT_MS=90000
