package paperpersist

import (
    "context"
    "time"
    "go.mongodb.org/mongo-driver/mongo"
    "go.mongodb.org/mongo-driver/bson"
    "go.mongodb.org/mongo-driver/mongo/options"
)

type TradeWriter struct {
    coll       *mongo.Collection
    trades     <-chan PaperTradeDoc
    retryQueue []PaperTradeDoc
    logger     Logger
}

// Run drains the trades channel and upserts to MongoDB.
// Retries failed writes with exponential backoff (max 5 attempts).
func (w *TradeWriter) Run(ctx context.Context) {
    ticker := time.NewTicker(5 * time.Second)
    for {
        select {
        case <-ctx.Done():
            return
        case trade := <-w.trades:
            w.upsert(ctx, trade)
        case <-ticker.C:
            w.flushRetryQueue(ctx)
        }
    }
}

func (w *TradeWriter) upsert(ctx context.Context, trade PaperTradeDoc) {
    filter := bson.M{"client_trade_id": trade.ClientTradeID}
    update := bson.M{"$set": trade}
    opts := options.Update().SetUpsert(true)
    _, err := w.coll.UpdateOne(ctx, filter, update, opts)
    if err != nil {
        w.retryQueue = append(w.retryQueue, trade)
    }
}
