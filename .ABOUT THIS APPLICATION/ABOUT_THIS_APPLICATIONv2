// agents.go:1106 — Decide()
func (o *MultiAgentOrchestrator) Decide(ctx context.Context, market MarketContext) AIDecision {
  agentCtx, cancel := context.WithTimeout(ctx, 15*time.Second)

  // Parallel execution [line 1129-1141]
  wg.Add(3)
  go func() { bullSig = o.runBullAgentWithFallback(agentCtx, market) }()
  go func() { bearSig = o.runBearAgentWithFallback(agentCtx, market) }()
  go func() { macroSig = o.runMacroAgentWithFallback(agentCtx, market) }()
  wg.Wait()

  // Short-circuit HOLD if all agents bearish [line 1151]
  if !bullSig.ShouldTrade && !bearSig.ShouldTrade && !macroSig.ShouldTrade {
    return HOLD decision
  }

  // Risk agent arbiter [line 1181]
  riskVerdict = o.runRiskAgentWithFallback(agentCtx, bull, bear, macro, market)

  return buildDecision(market, bull, bear, macro, riskVerdict)
}
