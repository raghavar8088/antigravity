# Antigravity Trading Engine Environment Variables

# 1. Exchange API Keys (Binance)
# WARNING: NEVER enable "Withdawals" on these keys!
BINANCE_API_KEY=your_public_api_key_here
BINANCE_API_SECRET=your_private_api_secret_here

# 2. Database & Data Warehouse
DATABASE_URL=postgres://antigravity:password123@localhost:5432/antigravity
REDIS_URL=redis://localhost:6379
# MongoDB stores paper/mock trading history, account snapshots, analytics, and logs.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=loop_trades

# 3. AI Service Configuration
AI_GRPC_HOST=localhost:50051

# 4. AI Agent Keys (Multi-Model Council)
# Bull + Bear agents use gpt-4o-mini; Risk arbitration uses gpt-4o
OPENAI_API_KEY=sk-...
# Macro Analyst agent — Gemini Flash 2.0 top-down market view (optional but recommended)
GEMINI_API_KEY=AIza...
# Free Signals Auditor — Groq Llama-3-70b (fallback if OpenAI is out of credits)
GROQ_API_KEY=gsk_...

# 5. Engine Parameters
MAX_POSITION_BTC=0.5
MAX_DAILY_LOSS_PCT=0.10

# Starting balance for the live BTC futures paper account (USD). Minimum: $100.
# Default if unset: $1,000,000. Changing this only affects a FRESH boot/reset —
# an already-running account's equity is persisted in MongoDB/SQLite and is
# unaffected until that state is explicitly reset.
INITIAL_PAPER_BALANCE_USD=100
# Starting balance for the BTC options-selling paper account (USD). If unset,
# falls back to INITIAL_PAPER_BALANCE_USD (kept in sync by default). Set
# explicitly only if the options desk should diverge from the futures desk.
INITIAL_OPTIONS_BALANCE_USD=100

# Paper trading auto-execute: set to "true" or "1" to bypass Command Center bridge parking.
# When enabled, all strategy signals that pass regime/risk/confidence gates execute directly
# in paper trading without waiting for manual approval in the Command Center UI.
# REQUIRED for paper trading to place trades automatically.
PAPER_TRADING_AUTO_EXECUTE=true

# Delta Exchange probe (optional — defaults to India endpoint, no auth needed for public tickers)
DELTA_API_BASE_URL=https://api.india.delta.exchange

# Delta Exchange API credentials (required for BTC live option chain)
DELTA_API_KEY=
DELTA_API_SECRET=
# DELTA_API_BASE_URL defaults to https://api.india.delta.exchange — override only if needed
# DELTA_API_BASE_URL=https://api.india.delta.exchange

# Internal server-to-server URL for Next.js → Go engine calls (never expose to browser)
# Set to your Go engine's internal hostname, e.g. http://localhost:8080 or http://engine:8080
INTERNAL_API_URL=http://localhost:8080

# Admin secret shared between Vercel and Go engine (required for /api/admin/* endpoints).
# Generate with: openssl rand -hex 32
# Must be set identically in Vercel env vars AND in the Go engine .env / systemd environment.
ENGINE_ADMIN_SECRET=

# 6. Scalers Concentration Gate (correlated same-direction exposure limits)
# Max strategies allowed concurrently open in the same direction (default 2).
MAX_CORRELATED_STRATEGIES=2
# Max combined BTC size across same-direction open scalers positions (default 0.30).
MAX_CORRELATED_BTC=0.30

# 7. Walk-Forward Strategy Promotion/Demotion Thresholds
# Trades per evaluation window (default 30).
WALKFORWARD_MIN_TRADES=30
# Consecutive passing windows required before a strategy is promoted to ACTIVE (default 2).
WALKFORWARD_CONSECUTIVE_WINDOWS=2
# Minimum rolling win rate to pass a window (default 0.48).
WALKFORWARD_WIN_RATE_THRESHOLD=0.48
# Minimum rolling Sharpe ratio to pass a window (default 0.60).
WALKFORWARD_SHARPE_THRESHOLD=0.60
# Reserved for future drawdown-based demotion (default 0.20) — not yet enforced by the validator.
WALKFORWARD_MAX_DRAWDOWN=0.20

# 8. Trade Threshold Configuration module (engine/internal/config — ThresholdRegistry)
# Every var below is editable at runtime via Strategies → Trade Thresholds in the
# dashboard (POST /api/engine/config, X-Engine-Admin-Secret required). The values
# here are only the startup defaults; the live value is the registry's, not this file.
MIN_EXECUTABLE_CONFIDENCE=0.68
MIN_BRIDGE_CONFIDENCE=0.65
MIN_REWARD_TO_RISK_RATIO=2.40
MIN_SIGNAL_TAKE_PROFIT_PCT=0.15
MAX_SIGNAL_STOP_LOSS_PCT=1.50
SCALER_RR_MINIMUM=2.00
SCALER_SL_LOWER_BOUND_PCT=0.25
MIN_EXECUTION_SIZE_BTC=0.01
FUTURES_POSITION_CAPITAL_PCT=0.01
KELLY_MAX_POSITION_PCT=0.10
KELLY_MIN_TRADES_REQUIRED=30
AI_SIGNAL_MAX_SIZE_BTC=0.50
RISK_INTRADAY_DRAWDOWN_PCT=0.02
RISK_CORRELATION_EXPOSURE_THRESHOLD=0.60
RISK_CORRELATION_MIN_CONFIDENCE=0.80
PMS_MAX_HEAT_PCT=8
PMS_MAX_VAR95_PCT=6
PMS_MAX_CVAR95_PCT=9
PMS_MAX_DRAWDOWN_PCT=10
PMS_MAX_DAILY_LOSS_PCT=3
PMS_MAX_GROSS_EXPOSURE_PCT=250
PMS_MAX_NET_EXPOSURE_PCT=150
MAX_OPEN_LONG_TRADES=3
MAX_OPEN_SHORT_TRADES=3
COOLDOWN_SNIPER_SWEEP_REVERSION_SEC=30
COOLDOWN_TREND_FADE_VWAP_SEC=180
COOLDOWN_BREAKOUT_FUNDING_OI_SEC=600
COOLDOWN_ADX_MOMENTUM_SEC=1800
COOLDOWN_DEFAULT_SEC=30
REGIME_ATR_HIGH_VOL_RATIO=2.0
REGIME_ATR_EXTREME_VOL_RATIO=3.0
REGIME_ADX_TREND_THRESHOLD=25
REGIME_ADX_RANGE_THRESHOLD=20
MIN_EXECUTION_WEIGHT_TO_TRADE=0.50
