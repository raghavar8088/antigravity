# Copy to `.env.local` for local dev (Next.js loads automatically).

# Supabase auth + paper trades safety mirror (kept as parallel store).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── MongoDB Atlas (PRIMARY paper trades store) ──────────────────────────────
# When MONGODB_URI is set, /api/paper-trades writes to MongoDB FIRST. Supabase
# is written as a best-effort mirror; a failed Supabase mirror does NOT fail
# the request when Mongo accepted the write. GET reads MongoDB first and falls
# back to Supabase on connection error.
# Leave MONGODB_URI blank to disable Mongo and run Supabase-only (legacy mode).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=LOOP-trades
# MONGODB_DB=loop_trades

# Paper desk policy (NEXT_PUBLIC_* are readable in the browser)
NEXT_PUBLIC_DESK_SLIPPAGE_BPS=5
NEXT_PUBLIC_DESK_AUTO_DISABLE_STRATS=1
NEXT_PUBLIC_DESK_VOL_SIZED_NOTIONAL=1
NEXT_PUBLIC_DESK_RISK_PCT_OF_EQUITY=0.01
NEXT_PUBLIC_DESK_MAX_LAST_MARK_SPREAD_PCT=0.05
NEXT_PUBLIC_DESK_MAX_OPEN_PER_CATEGORY=3
NEXT_PUBLIC_DESK_ENTRY_REPLACE_WEAKEST=0
# UTC entry window: 0 + 24 = always open; e.g. 12–22 = entries only 12:00–21:59 UTC
NEXT_PUBLIC_DESK_ENTRY_UTC_START=0
NEXT_PUBLIC_DESK_ENTRY_UTC_END=24
# Entry funnel debug panel on BTC futures desks (last poll skip counters)
NEXT_PUBLIC_DESK_ENTRY_DEBUG=0
# Dev replay panel (optional)
NEXT_PUBLIC_DESK_REPLAY_UI=0
# Manual Delta testnet ops panel (P3-B; requires sign-in + server Delta keys)
NEXT_PUBLIC_DESK_TESTNET_OPS=0
# Paper shadow intents — log paper open/close vs future testnet (P3-C; sign-in required)
NEXT_PUBLIC_DESK_SHADOW_INTENTS=0
NEXT_PUBLIC_DESK_SHADOW_LOG_OPEN=0
# Server-only Delta testnet (P3-A/P3-B) — never NEXT_PUBLIC_*
# DELTA_API_KEY=
# DELTA_API_SECRET=
# DELTA_TESTNET=1

# ── BTC Future Trading module-only flags ────────────────────────────────────
# Roster: comma-separated strategy IDs to activate (default = CORE ~20 IDs; cap 120).
# Setting > 30 IDs shows a DeskBanner warning; on chop candidatesBuilt ≈ 0 is expected.
# See README#btc-ft-no-trades for troubleshooting.
# NEXT_PUBLIC_BTC_FT_STRATEGY_IDS=91,92,95,96,111,112,117,118,123,124,125,126,131,132,133,134,139,140,151,152

# Roster: use CORE + top-10 from btc_ft_strategy_rankings.json (requires npm run rank:btc-ft first)
# NEXT_PUBLIC_BTC_FT_USE_RANKED=1

# Signal threshold for BTC FT module only (default 26, clamp 18–32).
# Lower = more candidates on chop; 24 is a reasonable starting point for chop diagnostics.
# Do NOT lower the global desk threshold — this env is module-only.
# NEXT_PUBLIC_BTC_FT_SIGNAL_THRESHOLD=26

# Dev-only: relax HTF/confluence confirmation gate (default OFF; NEVER enable in production).
# Set only when diagnosing why confirm fails on chop; paper-only, no exchange impact.
# NEXT_PUBLIC_BTC_FT_RELAX_CONFIRM=1

# Dev-only: force one probe LONG paper position after first ready poll (default OFF).
# Proves the open/close/ledger path independently from the signal path.
# NEXT_PUBLIC_DESK_FORCE_PROBE_OPEN=1

# ── BTC FT Research tournament ───────────────────────────────────────────────
# Paper-only mode for per-strategy profitability discovery. Production default
# remains CORE roster + threshold 26 unless this flag is set.
# NEXT_PUBLIC_BTC_FT_RESEARCH_MODE=1
# NEXT_PUBLIC_BTC_FT_POOL_IDS=91,92,95,96,111,112,117,118,123,124,125,126,131,132,133,134,139,140,151,152,200,201
# NEXT_PUBLIC_BTC_FT_SIGNAL_THRESHOLD=22
# NEXT_PUBLIC_BTC_FT_RELAX_CONFIRM=1
# NEXT_PUBLIC_BTC_FT_COOLDOWN_MUL=0.5
# NEXT_PUBLIC_BTC_FT_MIN_MOVE_K_MUL=0.85
# NEXT_PUBLIC_BTC_FT_SESSION=0-24
# NEXT_PUBLIC_BTC_FT_DISABLE_AUTO_KILL=1
# NEXT_PUBLIC_BTC_FT_RESEARCH_ENSURE_TRADES=0
# After research, paste promoted winners here for production live-prep paper:
# NEXT_PUBLIC_BTC_FT_WINNER_IDS=
# Winners production mode: disables research rotation and runs only promoted/manual winners.
# Conservative gates are forced: threshold 26, relax-confirm off, cooldown 1x, min-move K 1x, auto-kill on.
# NEXT_PUBLIC_BTC_FT_WINNERS_ONLY=1
# NEXT_PUBLIC_BTC_FT_STRATEGY_IDS=91,92,95

# ── BTC FT Phase 1 generated research pool (IDs 300–399) ─────────────────────
# 100 additional template-generated strategies (8 templates × 4 variants × 2 sides)
# enrolled into the research pool ONLY. Never auto-active on the production module.
# Default behavior:
#   - NEXT_PUBLIC_BTC_FT_RESEARCH_MODE=1 → generated pool defaults ON (=1)
#   - NEXT_PUBLIC_BTC_FT_RESEARCH_MODE unset → generated pool defaults OFF
# Override explicitly with this flag:
# NEXT_PUBLIC_BTC_FT_GENERATED_POOL=1
#
# Rotation still capped at ~30 strategies per 24h batch via the existing rotation
# mechanism; pool > 80 triggers a UI warning banner. See PAPER_DESK_RUNBOOK.md
# "Adding 100 strategies safely".
