# Copy to `.env.local` for local dev (Next.js loads automatically).

# ── Auth (MongoDB JWT — Supabase magic-link removed) ─────────────────────────
# Required server-side secret for the raig_session httpOnly cookie. Without it,
# /api/auth/signin and /api/auth/session return 503. 32+ random chars recommended.
AUTH_JWT_SECRET=change-me-to-a-32-char-random-string

# Supabase kept for legacy DB reads only (paper_trades mirror). Auth is MongoDB.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── MongoDB Atlas (PRIMARY paper trades store + auth) ────────────────────────
# REQUIRED — paper-trades POST returns 503 MONGO_NOT_CONFIGURED without this.
# Get URI from Atlas → Connect → Drivers → Node.js.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=LOOP-trades
MONGODB_DB=loop_trades

# ── Dual Persistence — Local Filesystem Storage ──────────────────────────────
# Absolute path for the local data directory (backup, NDJSON audit, CSV exports).
# Defaults to <repo-root>/data/ when unset (i.e. one level above client/).
# Set to an absolute path if your deployment differs.
# LOCAL_DATA_DIR=/absolute/path/to/data

# ── Anonymous paper trade writes (no sign-in required) ───────────────────────
# Client flag (NEXT_PUBLIC_): browser uses an anon_<uuid> account_key.
# Server flag: /api/paper-trades accepts body.accountKey when no session present.
# SECURITY: any caller who knows the URL can write. OK for personal research only.
NEXT_PUBLIC_ALLOW_ANON_PAPER_TRADES=1
ALLOW_PAPER_TRADES_ANON=1
# Legacy alias still accepted for backwards-compat:
ALLOW_ANON_PAPER_TRADES=1

# Paper desk policy (NEXT_PUBLIC_* are readable in the browser)
NEXT_PUBLIC_DESK_SLIPPAGE_BPS=5
NEXT_PUBLIC_DESK_AUTO_DISABLE_STRATS=1
NEXT_PUBLIC_DESK_VOL_SIZED_NOTIONAL=1
NEXT_PUBLIC_DESK_RISK_PCT_OF_EQUITY=0.01
NEXT_PUBLIC_DESK_MAX_LAST_MARK_SPREAD_PCT=0.05
NEXT_PUBLIC_DESK_MAX_OPEN_PER_CATEGORY=3
NEXT_PUBLIC_DESK_ENTRY_REPLACE_WEAKEST=0

# PROFIT_LOCK net-projection guard (anti-fee-bleed). When the projected USD net
# after exit slippage + round-trip fees + funding is below this, the
# PROFIT_LOCK exit is SKIPPED and the position remains open (TRAIL / TP / SL
# still resolve normally). Stops the desk from booking micro-losses dressed up
# as locked-in wins. Default 0.05 (clamp [0, 5]).
NEXT_PUBLIC_DESK_PROFIT_LOCK_MIN_NET_USD=0.05
# Progress-toward-TP threshold before PROFIT_LOCK can fire. Default 0.55
# (was 0.6). Lower = lock earlier but with smaller cushion vs fees.
NEXT_PUBLIC_DESK_PROFIT_LOCK_MIN_PROGRESS=0.55
# Min absolute net USD floor applied to tiny wins. Default 0 in research mode
# (raw expectancy) and 2 in production (display-friendly floor). Set to 0
# everywhere if you want unfiltered analytics. Clamp [0, 5].
# NEXT_PUBLIC_DESK_MIN_ABS_NET_WIN_USD=0

# ── v2 expectancy features (5 toggles) ──────────────────────────────────────
# #1+#2: Capital allocation by edge — scales per-strategy notional using a
# combined Kelly (half-Kelly clamped) + Sharpe-vs-cohort multiplier in
# [0.25, 3.0]. Strategies below ALLOCATION_MIN_TRADES=20 get 1.0 (no change),
# so enabling early is safe. Recommended once you have ≥3 days of paper data.
# NEXT_PUBLIC_DESK_ALLOCATION_BY_EDGE=1
#
# #3: Adaptive TP — scales strat.tpPct by ATR/price (low vol → tighten 0.8x,
# high vol → widen 1.4x; clamped). DEFAULT ON. Set to 0 to disable.
# NEXT_PUBLIC_DESK_ADAPTIVE_TP=1
#
# #4: Per-strategy time-of-day session gate — blocks entry at UTC hours where
# the strategy historically has winRate < 35% AND expectancy < 0. Requires ≥50
# total trades + ≥5 trades in the queried hour before the gate engages.
# Recommended once you have ≥1 week of paper data per strategy.
# NEXT_PUBLIC_DESK_SESSION_GATE=1
#
# #5: Correlation-aware open caps (in addition to MAX_OPEN_POSITIONS=12).
# Default: max 6 per side, max 2 per template family. Stricter = more
# diversification, fewer concurrent correlated bets.
# NEXT_PUBLIC_DESK_MAX_OPEN_PER_SIDE=6
# NEXT_PUBLIC_DESK_MAX_OPEN_PER_TEMPLATE=2

# ── Firehose mode (research-only, fee-heavy) ─────────────────────────────────
# Maximizes trade volume for fast per-strategy verdict discovery. Enable ONLY
# in research mode — NEVER in production. Expect 10–20+ concurrent positions
# and significant fee bleed; the goal is fast learning, not profit.
#
# Honest invariants kept: fees, slippage, liquidation cross, funding accrual.
# What firehose does:
#   - MAX_OPEN_POSITIONS effective: 12 → 60
#   - Per-side cap: 6 → 30 (effective)
#   - Per-template-family cap: 2 → 10 (effective)
#   - Daily strat cap: disabled (strategies can keep firing all day)
#   - UI shows a prominent warning banner
#
# NEXT_PUBLIC_BTC_FT_FIREHOSE=1

# Initial paper balance USD. Default $1,000. Set to $1,000,000 to pair with
# the 1%-of-equity flat-notional sizing below (each trade = $10,000 notional).
# Clamped to [100, 100,000,000].
# NEXT_PUBLIC_DESK_INITIAL_BALANCE_USD=1000000

# Fixed % of equity per trade — OVERRIDES vol-based sizing when > 0. Every
# trade uses exactly this % of current equity as notional. Clamped to [0, 5].
# 1.0 → 1% of equity (e.g. $10K on $1M paper balance).
# NEXT_PUBLIC_DESK_FIXED_NOTIONAL_PCT_OF_EQUITY=1.0

# Effective MAX_OPEN_POSITIONS — overrides the auto-pick (12 normal, 60 firehose).
# Clamp [1, 100]. Use to fine-tune the concurrency ceiling.
# NEXT_PUBLIC_DESK_MAX_OPEN_POSITIONS=60
# UTC entry window: 0 + 24 = always open; e.g. 12–22 = entries only 12:00–21:59 UTC
NEXT_PUBLIC_DESK_ENTRY_UTC_START=0
NEXT_PUBLIC_DESK_ENTRY_UTC_END=24
# Entry funnel debug panel on BTC futures desks (last poll skip counters)
NEXT_PUBLIC_DESK_ENTRY_DEBUG=0
# Dev replay panel (optional)
NEXT_PUBLIC_DESK_REPLAY_UI=0
# Manual Delta testnet ops panel (P3-B; requires sign-in + server Delta keys)
NEXT_PUBLIC_DESK_TESTNET_OPS=0
# Paper shadow intents — log paper open/close vs future testnet (P3-C; sign-in required)
NEXT_PUBLIC_DESK_SHADOW_INTENTS=0
NEXT_PUBLIC_DESK_SHADOW_LOG_OPEN=0
# Server-only Delta testnet (P3-A/P3-B) — never NEXT_PUBLIC_*
# DELTA_API_KEY=
# DELTA_API_SECRET=
# DELTA_TESTNET=1

# ── BTC Future Trading module-only flags ────────────────────────────────────
# Roster: comma-separated strategy IDs to activate (default = CORE ~20 IDs; cap 120).
# Setting > 30 IDs shows a DeskBanner warning; on chop candidatesBuilt ≈ 0 is expected.
# See README#btc-ft-no-trades for troubleshooting.
# NEXT_PUBLIC_BTC_FT_STRATEGY_IDS=91,92,95,96,111,112,117,118,123,124,125,126,131,132,133,134,139,140,151,152

# Roster: use CORE + top-10 from btc_ft_strategy_rankings.json (requires npm run rank:btc-ft first)
# NEXT_PUBLIC_BTC_FT_USE_RANKED=1

# Signal threshold for BTC FT module only (default 26, clamp 18–32).
# Lower = more candidates on chop; 24 is a reasonable starting point for chop diagnostics.
# Do NOT lower the global desk threshold — this env is module-only.
# NEXT_PUBLIC_BTC_FT_SIGNAL_THRESHOLD=26

# Dev-only: relax HTF/confluence confirmation gate (default OFF; NEVER enable in production).
# Set only when diagnosing why confirm fails on chop; paper-only, no exchange impact.
# NEXT_PUBLIC_BTC_FT_RELAX_CONFIRM=1

# Dev-only: force one probe LONG paper position after first ready poll (default OFF).
# Proves the open/close/ledger path independently from the signal path.
# NEXT_PUBLIC_DESK_FORCE_PROBE_OPEN=1

# ── BTC FT Research tournament ───────────────────────────────────────────────
# Paper-only mode for per-strategy profitability discovery. Production default
# remains CORE roster + threshold 26 unless this flag is set.
# NEXT_PUBLIC_BTC_FT_RESEARCH_MODE=1
# NEXT_PUBLIC_BTC_FT_POOL_IDS=91,92,95,96,111,112,117,118,123,124,125,126,131,132,133,134,139,140,151,152,200,201
# NEXT_PUBLIC_BTC_FT_SIGNAL_THRESHOLD=22
# NEXT_PUBLIC_BTC_FT_RELAX_CONFIRM=1
# Anti-churn: cooldown multiplier raised 0.5 → 0.75 (v2 default).
# NEXT_PUBLIC_BTC_FT_COOLDOWN_MUL=0.75
# Anti-churn: min-move K multiplier raised 0.85 → 1.0 (v2 default — full fee hurdle).
# NEXT_PUBLIC_BTC_FT_MIN_MOVE_K_MUL=1.0
# Anti-churn: max trade closes per strategy per UTC day in research mode.
# Default 8. Once a strategy hits the cap, new entries are skipped until
# the next UTC day; stat exposed as deskSkippedDailyStratCap.
# NEXT_PUBLIC_BTC_FT_DAILY_STRAT_CAP=8
# NEXT_PUBLIC_BTC_FT_SESSION=0-24
# NEXT_PUBLIC_BTC_FT_DISABLE_AUTO_KILL=1
# NEXT_PUBLIC_BTC_FT_RESEARCH_ENSURE_TRADES=0
# After research, paste promoted winners here for production live-prep paper:
# NEXT_PUBLIC_BTC_FT_WINNER_IDS=
# Winners production mode: disables research rotation and runs only promoted/manual winners.
# Conservative gates are forced: threshold 26, relax-confirm off, cooldown 1x, min-move K 1x, auto-kill on.
# NEXT_PUBLIC_BTC_FT_WINNERS_ONLY=1
# NEXT_PUBLIC_BTC_FT_STRATEGY_IDS=91,92,95

# ── 24/7 Headless VPS Worker ─────────────────────────────────────────────────
# Run `npx tsx scripts/btc-ft-paper-worker.ts` on a VPS (or via pm2) so the
# paper desk runs continuously without a browser tab open.
#
# REQUIRED on the VPS (copy from .env.local):
#   DESK_WORKER_ACCOUNT_KEY — the same UUID used when you sign into the browser desk.
#     For anon mode, use the anon_<uuid> value from your browser's localStorage key
#     "btc_future_trading_v4_account_key" (or equivalent DESK_WORKER_STORAGE_NAMESPACE).
# DESK_WORKER_ACCOUNT_KEY=your-uuid-here
#
#   MONGODB_URI + MONGODB_DB — same Atlas connection as above (already set).
#
#   NEXT_PUBLIC_VERCEL_URL — deployed app URL so the worker can fetch klines.
#     Example: your-app.vercel.app (no https://, the worker prepends it).
# NEXT_PUBLIC_VERCEL_URL=your-app.vercel.app
#
# OPTIONAL worker tuning:
#   Storage namespace (must match browser). Default: btc_future_trading_v4
# DESK_WORKER_STORAGE_NAMESPACE=btc_future_trading_v4
#   Comma-separated strategy IDs to run. Default: all enabled strategies.
# DESK_WORKER_STRATEGY_IDS=91,92,95,96
#   Poll interval in ms. Minimum 2000. Default 4000.
# POLL_MS=4000
#
# Browser-side flags (set in Vercel dashboard or .env.local):
#   Show the DeskRunModePanel + worker banners in the browser UI.
# NEXT_PUBLIC_DESK_WORKER_ENABLED=1
#   Request a browser screen wake lock while the desk is live (keeps tab alive).
# NEXT_PUBLIC_DESK_WAKE_LOCK=1
#
# Cron safety net — fires /api/cron/paper-desk-tick every 60s when VPS is stale.
# REQUIRED for cron auth. Generate with: openssl rand -hex 32
# CRON_SECRET=change-me-to-a-64-char-random-hex-string
#
# Quick start (VPS or local):
#   cd client
#   cp .env.local.example .env.local   # fill DESK_WORKER_ACCOUNT_KEY + NEXT_PUBLIC_VERCEL_URL
#   npx tsx scripts/btc-ft-paper-worker.ts
#
# pm2 (recommended for 24/7):
#   pm2 start ecosystem.worker.config.cjs --name btc-ft-worker
#   pm2 save && pm2 startup

# ── BTC FT Phase 1 generated research pool (IDs 300–399) ─────────────────────
# 100 additional template-generated strategies (8 templates × 4 variants × 2 sides)
# enrolled into the research pool ONLY. Never auto-active on the production module.
# Default behavior:
#   - NEXT_PUBLIC_BTC_FT_RESEARCH_MODE=1 → generated pool defaults ON (=1)
#   - NEXT_PUBLIC_BTC_FT_RESEARCH_MODE unset → generated pool defaults OFF
# Override explicitly with this flag:
# NEXT_PUBLIC_BTC_FT_GENERATED_POOL=1
#
# Rotation still capped at ~30 strategies per 24h batch via the existing rotation
# mechanism; pool > 80 triggers a UI warning banner. See PAPER_DESK_RUNBOOK.md
# "Adding 100 strategies safely".
