# Dockerfile.scalp — builds the scalp_prelive paper desk (cmd/scalp_prelive).
# 100-strategy x 8-symbol 1m PAPER desk. No broker keys, no order routing —
# it only reads public Binance klines and serves read-only stats. The only
# env it consumes is SCALP_API_TOKEN (optional endpoint gate).
FROM golang:1.25-alpine AS builder

WORKDIR /app
COPY go.mod ./
COPY cmd/scalp_prelive ./cmd/scalp_prelive
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -mod=mod \
    -ldflags="-s -w" \
    -o /bin/scalp_prelive ./cmd/scalp_prelive

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 10001 app && adduser -D -u 10001 -G app app
COPY --from=builder /bin/scalp_prelive /app/scalp_prelive
RUN mkdir -p /app/data/scalp_prelive && chown -R 10001:10001 /app/data

USER 10001:10001
WORKDIR /app
EXPOSE 8094
ENTRYPOINT ["/app/scalp_prelive", "-port", "8094", "-state", "/app/data/scalp_prelive"]
