FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk --no-cache add ca-certificates tzdata git

COPY go.mod ./
COPY cmd/pre_live ./cmd/pre_live
COPY internal ./internal
COPY data/backtest_results.json ./data/backtest_results.json
# Pre-Live whitelists (qualification outputs). Only read when
# PRE_LIVE_WHITELIST_FILE points at one — the default instance ignores them.
COPY data/btc_prelive_whitelist.json ./data/btc_prelive_whitelist.json
COPY data/eth_prelive_whitelist.json ./data/eth_prelive_whitelist.json

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -mod=mod \
    -ldflags="-s -w -extldflags=-static" \
    -trimpath \
    -o /bin/pre_live ./cmd/pre_live

FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /bin/pre_live /app/pre_live
COPY --from=builder /app/data/backtest_results.json /app/data/backtest_results.json
COPY --from=builder /app/data/btc_prelive_whitelist.json /app/data/btc_prelive_whitelist.json
COPY --from=builder /app/data/eth_prelive_whitelist.json /app/data/eth_prelive_whitelist.json

USER 10001:10001

EXPOSE 8082

ENV GOMEMLIMIT=300MiB
ENV GOGC=80
ENV PRE_LIVE_PORT=8082
ENV PRE_LIVE_INITIAL_BALANCE_USD=100
ENV BACKTEST_RESULTS_PATH=/app/data/backtest_results.json

ENTRYPOINT ["/app/pre_live"]
